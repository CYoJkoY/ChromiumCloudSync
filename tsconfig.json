{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "rootDir": ".",
    "outDir": ".build",
    "strict": false,
    "noCheck": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": false,
    "types": ["node"]
  },
  "files": [
    "background.ts",
    "browser-capabilities.ts",
    "diagnostics.ts",
    "legacy-crypto.ts",
    "schema.ts",
    "storage.ts",
    "sync-core.ts",
    "src/features/extension-storage-watch.ts",
    "src/features/extension-storage.ts",
    "src/features/update.ts",
    "src/ui/extensions.ts",
    "src/ui/guide.ts",
    "src/ui/history.ts",
    "src/ui/i18n.ts",
    "src/ui/options.ts",
    "src/ui/popup-fixes.ts",
    "src/ui/popup-i18n.ts",
    "src/ui/popup.ts",
    "src/ui/runtime.ts",
    "src/ui/theme.ts"
  ]
}
